{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["id", "revision", "recorded_at", "schema_version", "payload"],
  "properties": {
    "id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "recorded_at": {"type": "string", "format": "date-time"}, "schema_version": {"const": "pco/hypothesis/v1"},
    "payload": {
      "type": "object", "additionalProperties": false, "required": ["statement", "confidence", "evidence_refs", "counter_evidence_refs", "status", "policy_version"],
      "properties": {"statement": {"type": "string", "minLength": 1}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "counter_evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "status": {"enum": ["hypothesis", "promoted", "disputed", "rejected", "superseded"]}, "policy_version": {"type": "string", "minLength": 1}, "revision_reason": {"type": "string"}}
    }
  }
}
