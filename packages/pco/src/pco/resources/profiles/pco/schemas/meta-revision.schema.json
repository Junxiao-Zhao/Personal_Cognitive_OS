{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["id", "revision", "recorded_at", "schema_version", "commit_ref", "payload"],
  "properties": {
    "id": {"const": "meta_current"}, "revision": {"type": "integer", "minimum": 1}, "recorded_at": {"type": "string", "format": "date-time"}, "schema_version": {"const": "pco/meta-revision/v1"}, "commit_ref": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_revision", "change_summary", "body_markdown", "evidence_refs", "promotion_refs", "status"],
      "properties": {
        "previous_revision": {"type": ["integer", "null"], "minimum": 1},
        "change_summary": {"type": "string", "minLength": 1}, "body_markdown": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "promotion_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "status": {"enum": ["active", "superseded", "tombstone"]}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"revision": {"minimum": 2}}, "required": ["revision"]},
    "then": {"properties": {"payload": {"properties": {"previous_revision": {"type": "integer", "minimum": 1}}}}}
  }]
}
